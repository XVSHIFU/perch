{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perch Studio Lab",
  "version": "1.0.0",
  "identifier": "dev.perch.studio.lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "栖点",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "zoomHotkeysEnabled": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src ipc: http://ipc.localhost; frame-src https://dsh-market.com; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../THIRD_PARTY/": "THIRD_PARTY/"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
