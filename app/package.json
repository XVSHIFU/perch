    "preview:single": "node scripts/single-preview.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
